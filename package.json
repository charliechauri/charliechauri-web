{
  "name": "charliechauri",
  "description": "Charliechauri's personal website",
  "version": "0.1.0",
  "author": "charliechauri",
  "license": "MIT",
  "engines": {
    "node": ">=26.8.1",
    "yarn": ">=1.22.22"
  },
  "dependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-router-dom": "^5.1.5",
    "husky": "^9.1.7",
    "i18next": "^26.4.1",
    "lint-staged": "^17.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.18.3",
    "sass": "^1.103.1",
    "typescript": "5.1.6"
  },
  "scripts": {
    "start": "vite",
    "postbuild": "yarn analyze --tsv",
    "build": "vite build",
    "test": "vitest",
    "test:nowatch": "vitest run --coverage --color",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src --color",
    "lint:autofix": "eslint --ext .js,.jsx,.ts,.tsx src --color --fix",
    "format:prettier": "prettier --write src/**/*.{ts,tsx,scss}",
    "pre-pull-request": "yarn test:nowatch && yarn build",
    "analyze": "source-map-explorer 'build/assets/*.js' --no-border-checks"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.ts": [
      "yarn lint:autofix",
      "yarn format:prettier"
    ],
    "*.tsx": [
      "yarn lint:autofix",
      "yarn format:prettier"
    ],
    "*.scss": [
      "yarn format:prettier"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-push": "yarn pre-pull-request"
    }
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "source-map-explorer": "^2.5.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "yarn@4.5.1"
}
